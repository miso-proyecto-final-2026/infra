aws_region   = "us-east-1"
project_name = "solventa"
environment  = "staging"
namespace    = "solventa-staging"

vpc_cidr = "10.60.0.0/16"
az_count = 2

# kubernetes_version: sin fijar (default null) = EKS usa su versión vigente.
# Fijar solo si necesitas una versión exacta (ver comentario en variables.tf).
node_instance_type  = "t3.medium"
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 2

db_name     = "solventa"
db_username = "solventa"
# db_password: pasar vía TF_VAR_db_password, NO en este archivo.
